DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=
DISABLE_MEDUSA_ADMIN=
JWT_SECRET=
COOKIE_SECRET=
CHECKOUT_PREPARATION_SECRET=
SESSION_COOKIE_NAME=
SESSION_TTL_MS=
PAYMENTS_ENABLED=
PAYMENT_PROVIDER_ENABLED=
GATE8_FINALIZATION_ENABLED=
CSP_ENFORCE=false
STOREFRONT_URL=

# File storage: local is development/test only; production/staging require S3/R2.
FILE_STORAGE_PROVIDER=local
LOCAL_FILE_UPLOAD_DIR=
LOCAL_FILE_UPLOAD_URL=http://localhost:9000/static
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_TOKEN_TTL_MS=900000
# Optional Resend resources. Leave blank until IDs are provisioned in the
# secure environment; local consent tests remain fail-closed without them.
RESEND_PASSWORD_RESET_TEMPLATE_ID=
RESEND_NEWSLETTER_CONFIRMATION_TEMPLATE_ID=
RESEND_AUDIENCE_ID=
# Newsletter uses these names. Legacy names remain below for the existing
# promotional broadcast integration.
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=
RESEND_SEGMENT_ID=
RESEND_PROMOTIONS_TOPIC_ID=
RESEND_WEBHOOK_SECRET=

# Commercial shipping V1. Grande SP is populated only from the
# Operations-approved geography source; never infer CEP bands. A real route
# provider is required before express delivery is enabled in production.
FRIGGAFRIO_SHIPPING_GRANDE_SP_CITIES=
FRIGGAFRIO_SHIPPING_CENTRAL_CITIES=
FRIGGAFRIO_SHIPPING_COAST_CITIES=
SHIPPING_POLICY_VERSION=1

# Operations-approved route provider. Both values are required before express
# shipping can be enabled; missing credentials fail closed.
FRIGGAFRIO_ROUTE_PROVIDER_URL=
FRIGGAFRIO_ROUTE_PROVIDER_API_KEY=

# Omie read-only discovery (leave blank until credentials are provisioned)
OMIE_API_URL=
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Google Integrations
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_STATE_TTL_MS=600000
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
