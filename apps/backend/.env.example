DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=
DISABLE_MEDUSA_ADMIN=
JWT_SECRET=
COOKIE_SECRET=
CHECKOUT_PREPARATION_SECRET=
SESSION_COOKIE_NAME=
SESSION_TTL_MS=
PAYMENTS_ENABLED=
PAYMENT_PROVIDER_ENABLED=
GATE8_FINALIZATION_ENABLED=
STOREFRONT_URL=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# File storage: use "s3" only with a complete S3/R2 configuration. "local"
# is supported for development and for a persistent external V1 upload path.
FILE_STORAGE_PROVIDER=local
FILE_LOCAL_UPLOAD_DIR=
FILE_LOCAL_PRIVATE_UPLOAD_DIR=
FILE_LOCAL_BACKEND_URL=
R2_FILE_URL=
R2_PREFIX=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
S3_FILE_URL=
S3_PREFIX=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=

# Commercial shipping V1. Grande SP is populated only from the
# Operations-approved geography source; never infer CEP bands. A real route
# provider is required before express delivery is enabled in production.
FRIGGAFRIO_SHIPPING_GRANDE_SP_CITIES=

# Operations-approved route provider. Both values are required before express
# shipping can be enabled; missing credentials fail closed.
FRIGGAFRIO_ROUTE_PROVIDER_URL=
FRIGGAFRIO_ROUTE_PROVIDER_API_KEY=

# Omie read-only discovery (leave blank until credentials are provisioned)
OMIE_API_URL=
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Google Integrations
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
