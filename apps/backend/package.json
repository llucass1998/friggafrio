{
  "name": "backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test": "pnpm test:unit",
    "test:integration": "pnpm test:integration:http",
    "typecheck": "tsc --noEmit",
    "dev:tee": "medusa develop 2>&1 | tee -a ../backend.log",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "email:dev": "email-preview --dir ./src/email-templates --port 9004 --hostname 0.0.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/email-preview-server": "^0.0.10",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "^2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/types": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-query": "5.104.1",
    "@types/cors": "^2.8.19",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "react-hook-form": "^7.89.0",
    "react-i18next": "17.0.16",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "1.16.13",
    "@swc/jest": "^0.2.36",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "30.5.2",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
