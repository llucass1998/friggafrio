# Set FRIGGAFRIO_DOMAIN on the Caddy host to the public DNS name, for example:
# export FRIGGAFRIO_DOMAIN=loja.example.com
# The WSL OpenVPN address is deliberately private and used only as upstream.

{$FRIGGAFRIO_DOMAIN} {
	encode zstd gzip

	@admin_app path /app /app/*
	handle @admin_app {
		header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; frame-src 'none'"
		reverse_proxy {$FRIGGAFRIO_BACKEND_UPSTREAM:http://172.25.20.159:9000}
	}

	@backend path /store/* /auth/* /admin /admin/* /health /health/* /uploads/*
	handle @backend {
		reverse_proxy {$FRIGGAFRIO_BACKEND_UPSTREAM:http://172.25.20.159:9000}
	}

	handle {
		reverse_proxy {$FRIGGAFRIO_STOREFRONT_UPSTREAM:http://172.25.20.159:5173}
	}
}
